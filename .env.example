VITE_SUPABASE_URL=https://tu-proyecto.supabase.co
VITE_SUPABASE_ANON_KEY=tu-anon-key-aqui

# Backend - Correo (SMTP de Google; usar contraseña de aplicación)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=tu-cuenta@gmail.com
SMTP_PASS=tu-contrasena-de-aplicacion
EMAIL_FROM='GreenLine <tu-cuenta@gmail.com>'
# Destino de los mensajes del formulario de contacto (si se omite, usa EMAIL_FROM)
MAIL_TO=destino@gmail.com
# Destino de las notificaciones de pedidos (por defecto: greenlinemoto@gmail.com)
ORDERS_MAIL_TO=greenlinemoto@gmail.com

# Backend - Supabase (solo si el backend necesita acceder a Supabase)
# VITE_SUPABASE_URL=https://tu-proyecto.supabase.co
# VITE_SUPABASE_ANON_KEY=tu-anon-key-aqui
# Service role key (SOLO servidor, jamás en el bundle cliente). Obligatoria en producción.
# VITE_SUPABASE_SERVICE_ROLE_KEY=tu-service-role-key

# Backend - JWT
# JWT_SECRET=minimo-32-caracteres
# JWT_REFRESH_SECRET=minimo-32-caracteres
# JWT_TEMP_SECRET=minimo-32-caracteres (tokens temporales de challenge: puerta staff + 2FA)

# Backend - Puerta de acceso staff (código compartido verificado en el servidor)
# STAFF_GATE_CODE=0000

# Backend - Cifrado de campos sensibles en reposo (OTP, 2FA secret, backup codes). Mínimo 32 caracteres.
# FIELD_ENCRYPTION_KEY=minimo-32-caracteres

# Backend - Cola de emails (BullMQ). Opcional.
# Pega el "Internal Connection String" de la instancia Redis (Key-Value)
# `greenline-redis` en Render. Si se omite, el backend usa una cola en
# memoria (funciona, pero sin persistencia entre reinicios).
# REDIS_URL=rediss://default:password@host:port

# SonarQube - generador del reporte de incidencias (npm run sonar:report)
# SONAR_HOST_URL=http://localhost:9000
# SONAR_PROJECT_KEY=Greenline
# SONAR_TOKEN=sqp_crea-un-token-en-my-account-security
