{
  "name": "WF-04 - Solicitud a GitHub para Copilot",
  "nodes": [
    {
      "parameters": {},
      "id": "manual-trigger",
      "name": "Manual Trigger",
      "type": "n8n-nodes-base.manualTrigger",
      "typeVersion": 1,
      "position": [0, 0]
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "instruction",
              "name": "instruccion",
              "value": "Escribe aquí la solicitud de cambio para Greenline",
              "type": "string"
            }
          ]
        },
        "options": {}
      },
      "id": "request-input",
      "name": "Solicitud de cambio",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [220, 0]
    },
    {
      "parameters": {
        "promptType": "define",
        "text": "=Convierte esta solicitud en una especificación de trabajo para GitHub:\n\n{{ $json.instruccion }}",
        "hasOutputParser": true,
        "options": {
          "systemMessage": "Eres el analista y planificador de Greenline Web ERP.\n\nStack: React 19, Vite, Tailwind CSS v4, Supabase, Express, Zod, JavaScript y JSX.\n\nConvierte la solicitud en una historia de usuario clara para que otro agente pueda implementarla en una branch y abrir un Pull Request. Define criterios de aceptación verificables, archivos probables, plan técnico, pruebas requeridas, riesgos y preguntas pendientes. No inventes archivos ni afirmes que implementaste o probaste algo. Si faltan datos importantes, usa preguntas_pendientes y establece listo_para_implementar en false.\n\nLa rama base de desarrollo es develop. No incluy secretos ni valores de archivos .env."
        }
      },
      "id": "analyst",
      "name": "Analista y planificador",
      "type": "@n8n/n8n-nodes-langchain.chainLlm",
      "typeVersion": 1.6,
      "position": [520, 0]
    },
    {
      "parameters": {
        "modelName": "models/gemini-2.5-flash",
        "options": {
          "temperature": 0.2
        }
      },
      "id": "gemini-model",
      "name": "Google Gemini Chat Model",
      "type": "@n8n/n8n-nodes-langchain.lmChatGoogleGemini",
      "typeVersion": 1.3,
      "position": [420, 260]
    },
    {
      "parameters": {
        "jsonSchemaExample": "{\n  \"titulo\": \"Validar datos del checkout\",\n  \"historia_usuario\": \"Como cliente quiero registrar datos válidos para que Greenline pueda contactarme.\",\n  \"criterios_aceptacion\": [\n    \"El teléfono debe tener 9 dígitos y comenzar en 9\",\n    \"El DNI debe tener exactamente 8 dígitos\"\n  ],\n  \"archivos_probables\": [\n    \"frontend/pages/Checkout.jsx\",\n    \"backend/src/routes/pedidos.routes.js\"\n  ],\n  \"plan_tecnico\": [\n    \"Implementar validación en frontend y backend\"\n  ],\n  \"pruebas_requeridas\": [\n    \"npm run lint\",\n    \"npm run build\",\n    \"npm run security-smoke\",\n    \"cd backend && npm test\"\n  ],\n  \"riesgos\": [],\n  \"preguntas_pendientes\": [],\n  \"listo_para_implementar\": true\n}"
      },
      "id": "structured-parser",
      "name": "Structured Output Parser",
      "type": "@n8n/n8n-nodes-langchain.outputParserStructured",
      "typeVersion": 1.2,
      "position": [700, 260]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "typeValidation": "strict"
          },
          "conditions": [
            {
              "leftValue": "={{ $json.preguntas_pendientes ? $json.preguntas_pendientes.length : 0 }}",
              "rightValue": 0,
              "operator": {
                "type": "number",
                "operation": "equals"
              }
            },
            {
              "leftValue": "={{ $json.listo_para_implementar }}",
              "rightValue": true,
              "operator": {
                "type": "boolean",
                "operation": "equals"
              }
            }
          ],
          "combinator": "and"
        }
      },
      "id": "plan-ready",
      "name": "¿Plan listo?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [920, 0]
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "status",
              "name": "estado",
              "value": "BLOQUEADO_POR_ACLARACIONES",
              "type": "string"
            },
            {
              "id": "message",
              "name": "mensaje",
              "value": "La solicitud no se envió a GitHub porque tiene preguntas pendientes o el plan no está listo.",
              "type": "string"
            },
            {
              "id": "plan",
              "name": "plan",
              "value": "={{ JSON.stringify($json) }}",
              "type": "string"
            }
          ]
        },
        "options": {}
      },
      "id": "blocked",
      "name": "Solicitar aclaración",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [1160, 180]
    },
    {
      "parameters": {
        "jsCode": "const plan = $json;\nconst list = (items) => (items || []).map((item) => `- ${item}`).join('\\n');\nconst criteria = (plan.criterios_aceptacion || []).map((item) => `- [ ] ${item}`).join('\\n');\nconst files = list(plan.archivos_probables);\nconst technicalPlan = list(plan.plan_tecnico);\nconst tests = list(plan.pruebas_requeridas);\nconst risks = list(plan.riesgos) || '- Ninguno indicado';\n\nreturn [{\n  json: {\n    ...plan,\n    issueTitle: `[Agente] ${plan.titulo}`,\n    issueBody: `## Historia de usuario\\n\\n${plan.historia_usuario}\\n\\n## Criterios de aceptación\\n\\n${criteria}\\n\\n## Plan técnico\\n\\n${technicalPlan}\\n\\n## Archivos probables\\n\\n${files}\\n\\n## Pruebas requeridas\\n\\n${tests}\\n\\n## Riesgos\\n\\n${risks}\\n\\n## Instrucciones para Copilot coding agent\\n\\n- Trabaja en una branch nueva basada en develop.\\n- No modifiques develop directamente.\\n- No leas ni modifiques archivos .env ni secretos.\\n- Implementa todos los criterios de aceptación.\\n- Ejecuta las pruebas indicadas y reporta resultados reales.\\n- Abre un Pull Request contra develop.\\n- No hagas merge automático.\\n\\n> Este Issue fue generado por el workflow de n8n. La asignación a Copilot coding agent y la aprobación del merge requieren revisión humana.`\n  }\n}];"
      },
      "id": "build-issue",
      "name": "Construir Issue",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [1160, -80]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://api.github.com/repos/idmr023/greenline/issues",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Accept",
              "value": "application/vnd.github+json"
            },
            {
              "name": "X-GitHub-Api-Version",
              "value": "2022-11-28"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ title: $json.issueTitle, body: $json.issueBody, labels: ['agent-request'] }) }}",
        "options": {}
      },
      "id": "create-issue",
      "name": "Crear Issue en GitHub",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1420, -80]
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "status",
              "name": "estado",
              "value": "ISSUE_CREADO_REQUIERE_ASIGNACION",
              "type": "string"
            },
            {
              "id": "issueUrl",
              "name": "issue_url",
              "value": "={{ $json.html_url }}",
              "type": "string"
            },
            {
              "id": "issueNumber",
              "name": "issue_numero",
              "value": "={{ $json.number }}",
              "type": "number"
            },
            {
              "id": "issueBody",
              "name": "issueBody",
              "value": "={{ $node['Construir Issue'].json.issueBody }}",
              "type": "string"
            },
            {
              "id": "message",
              "name": "mensaje",
              "value": "Issue creado. Asigna Copilot coding agent en GitHub y espera el Pull Request.",
              "type": "string"
            }
          ]
        },
        "options": {}
      },
      "id": "issue-created",
      "name": "Issue creado",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [1660, -80]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://api.github.com/repos/idmr023/greenline/actions/workflows/copilot-agent.yml/dispatches",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Accept",
              "value": "application/vnd.github+json"
            },
            {
              "name": "X-GitHub-Api-Version",
              "value": "2022-11-28"
            },
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ ref: 'develop', inputs: { issue_numero: String($json.issue_numero), issueBody: $json.issueBody } }) }}",
        "options": {
          "response": {
            "response": {
              "neverError": true,
              "responseFormat": "json"
            }
          }
        }
      },
      "id": "dispatch-copilot-agent",
      "name": "Disparar GitHub Action",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1920, -80]
    }
  ],
  "connections": {
