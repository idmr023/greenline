{
  "name": "greenline-backend",
  "version": "1.0.1",
  "description": "GreenLine Backend API - Express + Prisma + PostgreSQL",
  "main": "src/index.js",
  "type": "module",
  "scripts": {
    "dev": "node --watch src/index.js",
    "start": "node --max-old-space-size=400 src/index.js",
    "build": "prisma generate",
    "seed": "node prisma/seed.js",
    "db:push": "prisma db push",
    "db:migrate": "prisma migrate dev",
    "db:studio": "prisma studio",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "backup:verify": "node scripts/verify-backup.mjs",
    "test:watch": "vitest"
  },
  "prisma": {
    "seed": "node prisma/seed.js"
  },
  "keywords": [],
  "author": "GreenLine",
  "license": "ISC",
  "dependencies": {
    "@asteasolutions/zod-to-openapi": "^9.1.0",
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "@scalar/express-api-reference": "^0.10.21",
    "@sentry/node": "^10.75.2",
    "@supabase/supabase-js": "^2.115.0",
    "argon2": "^0.45.1",
    "bullmq": "^6.3.4",
    "compression": "^1.8.1",
    "cookie": "^2.0.1",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "express-rate-limit": "^8.6.2",
    "googleapis": "^178.1.1",
    "helmet": "^8.3.0",
    "ioredis": "^6.0.0",
    "jsonwebtoken": "^9.0.3",
    "multer": "^2.3.0",
    "nodemailer": "^9.0.5",
    "otplib": "^13.5.0",
    "pg": "^8.23.0",
    "pino": "^10.3.1",
    "prisma": "^7.10.0",
    "qrcode": "^1.5.4",
    "sharp": "^0.35.3",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "^5.0.0",
    "concurrently": "^10.0.5",
    "supertest": "^7.2.2",
    "vitest": "^5.0.0"
  }
}
