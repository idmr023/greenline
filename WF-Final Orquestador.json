    {
      "parameters": {
        "jsCode": "const text=($json.parts||[]).filter(p=>p.type==='text'&&typeof p.text==='string').map(p=>p.text).join('\\n').replace(/^```(?:json)?\\s*/i,'').replace(/\\s*```$/i,'').trim(); if(!text) throw new Error('OpenCode no devolvio texto.'); try{return [{json:JSON.parse(text)}]}catch(e){throw new Error('Respuesta OpenCode no es JSON valido: '+e.message)}"
      },
