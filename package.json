{
  "name": "greenline-web-erp",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "node scripts/set-build-version.mjs && vite build --mode build",
    "lint": "oxlint",
    "security-smoke": "node scripts/security-smoke.mjs",
    "apply-audit-rls": "node scripts/aplicar-audit-rls.mjs",
    "preview": "vite preview",
    "sync_image": "node scripts/sincronizar-imagenes-greenline.mjs --local",
    "sync_clean": "node scripts/sincronizar-imagenes-greenline.mjs --cleanup",
    "generate-manuales": "node scripts/generate-manuales.mjs",
    "pdf:ceo": "node scripts/generar-pdf-ceo.mjs",
    "bench": "node scripts/bench.mjs 50",
    "sonar:report": "node scripts/fetch-sonar-issues.mjs",
    "all": "concurrently \"npm run dev:frontend\" \"npm run dev:backend\"",
    "dev:frontend": "cd frontend && npm run dev",
    "dev:backend": "cd backend && npm run dev"
  },
  "dependencies": {
    "@fortawesome/fontawesome-svg-core": "^7.3.1",
    "@fortawesome/free-brands-svg-icons": "^7.3.1",
    "@fortawesome/free-regular-svg-icons": "^7.3.1",
    "@fortawesome/free-solid-svg-icons": "^7.3.1",
    "@fortawesome/react-fontawesome": "^3.5.0",
    "@sentry/react": "^10.75.2",
    "@supabase/supabase-js": "^2.112.3",
    "@tailwindcss/vite": "^4.3.3",
    "@tiptap/core": "^3.31.3",
    "@tiptap/extension-image": "^3.31.3",
    "@tiptap/extension-link": "^3.31.3",
    "@tiptap/extension-placeholder": "^3.31.3",
    "@tiptap/extension-table": "^3.31.3",
    "@tiptap/extension-underline": "^3.31.3",
    "@tiptap/pm": "^3.31.3",
    "@tiptap/react": "^3.31.3",
    "@tiptap/starter-kit": "^3.31.3",
    "@vercel/analytics": "^2.0.1",
    "@vercel/speed-insights": "^2.0.0",
    "argon2": "^0.45.1",
    "canvas-confetti": "^1.9.4",
    "leaflet": "^1.9.4",
    "pdfjs-dist": "^3.11.174",
    "react": "^19.2.8",
    "react-dom": "^19.3.0",
    "react-helmet-async": "^3.0.0",
    "react-inner-image-zoom": "^4.0.2",
    "react-router-dom": "^7.18.2",
    "recharts": "^3.10.1",
    "sharp": "^0.35.3",
    "tailwindcss": "^4.3.3",
    "vite-plugin-pwa": "^1.3.0"
  },
  "devDependencies": {
    "@lhci/cli": "^0.15.1",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/typography": "^0.5.20",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.0.4",
    "concurrently": "^10.0.5",
    "dotenv": "^17.4.2",
    "oxlint": "^1.75.0",
    "puppeteer": "^25.11.0",
    "terser": "^5.51.2",
    "vite": "^8.2.0"
  },
  "allowScripts": {
    "puppeteer@25.11.0": true
  }
}
